# Джарвис -- настройки. Проще всего заполнить их в панели:  python panel.py
# Этот файл-образец копируется в .env. Настоящий .env никогда не коммитьте.

# ===== Обязательно =====
# Claude (мозг). console.anthropic.com -> API Keys. Нужен положительный баланс.
ANTHROPIC_API_KEY=
# Оставьте пустым, чтобы использовалась быстрая и недорогая Haiku.
ANTHROPIC_MODEL=

# Deepgram (распознавание речи). console.deepgram.com -> API Keys.
DEEPGRAM_API_KEY=
DEEPGRAM_LANGUAGE=ru

# ===== Модель разговора (необязательно) =====
# anthropic (по умолчанию, Claude), claude_code (Claude Code по подписке), openai (GPT-6 Sol/Luna) или ollama (локально). Для openai нужен
# OPENAI_API_KEY, если выбрано openai. platform.openai.com -> API Keys.
LLM_PROVIDER=anthropic
OPENAI_API_KEY=
# Оставьте пустым, чтобы использовалась быстрая gpt-6-luna. Для более
# глубоких рассуждений в ущерб скорости ответа: gpt-6-sol или gpt-6-astra.
OPENAI_MODEL=

# anthropic (по умолчанию) или openai -- какая модель управляет экраном
# «глазами» (use_computer). Отдельно от LLM_PROVIDER: можно, например,
# разговаривать через Claude, но смотреть на экран через GPT-6 Sol.
COMPUTER_USE_PROVIDER=anthropic
OPENAI_COMPUTER_USE_MODEL=

# ===== Локальная модель (бесплатно, без интернета) =====
# LLM_PROVIDER=ollama -- разговор ведёт локальная модель через Ollama (ollama.com).
# Модель готовит scripts/setup_local_llm.bat (Qwen3-8B, ~5 ГБ, нужна видеокарта от 8 ГБ).
OLLAMA_MODEL=jarvis-qwen3
# none -- отвечать сразу (быстро); low/medium -- сначала думать (умнее, но паузы).
OLLAMA_REASONING_EFFORT=none

# ===== Claude Code как мозг (по подписке, без API-ключа) =====
# LLM_PROVIDER=claude_code -- разговор ведёт локальный Claude Code CLI (`claude`), залогиненный
# в подписку Claude.ai. Ему доступны PowerShell, файлы, веб и все инструменты Джарвиса (через MCP).
# Модель: haiku (быстрее всего), sonnet, opus.
CLAUDE_CODE_MODEL=sonnet
# 1 -- модель сначала «думает» (умнее, но несколько секунд тишины перед ответом).
CLAUDE_CODE_THINKING=0
# default -- полный доступ к ПК, но каждое действие проверяет pc_guard.py: безопасное выполняется
# сразу, опасное (удаление, реестр, службы, установка программ, выключение, брандмауэр,
# отправка данных) ждёт голосового «да», а то, что ломает Windows (формат диска, загрузчик),
# не выполняется никогда.
# bypassPermissions -- разрешено вообще всё без подтверждений (на свой страх и риск).
CLAUDE_CODE_PERMISSION_MODE=default
# 1 -- мозгу доступны все локальные диски, 0 -- только домашняя папка.
CLAUDE_CODE_FULL_DISK_ACCESS=1

# ===== Характер =====
# classic -- вежливый помощник. roast -- дерзкий кореш: подколы, мат, смех и звуковые мемы.
# Мемы: файлы .mp3/.wav в data/memes (имя файла = название), смех -- в data/memes/смех.
JARVIS_PERSONA=classic
MEME_VOLUME=0.8

# ===== Озвучка =====
# edge -- бесплатно, без ключей.  elevenlabs -- живее, платно, поддерживает свои голоса.
TTS_PROVIDER=edge
TTS_VOICE=ru-RU-DmitryNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ===== Telegram (необязательно) =====
# Отдельный аккаунт для Джарвиса. api_id и api_hash: my.telegram.org -> API development tools.
# Вход в аккаунт выполняется в панели (кнопка «Войти в Telegram»).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# ===== Телефонные звонки (необязательно) =====
# cloud.livekit.io -> ваш проект -> Settings. Нужны только для приёма звонков.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Номера (через запятую), которым по телефону разрешено управлять компьютером.
# Остальным звонящим — только разговор. Пусто = никому.
PHONE_ALLOWED_NUMBERS=

# ===== Автономность и расходы =====
# Лимит расходов на ИИ в день, $. Выше него фоновые задачи и работа с экраном
# не запускаются до завтра (обычный разговор работает). 0 = без лимита.
DAILY_BUDGET_USD=3
# Сколько ждать вашего «да»/«нет» в Telegram на рискованный шаг фоновой задачи, секунд.
APPROVAL_TIMEOUT_S=600
# Сколько сообщений в день отвечать посторонним в Telegram.
TELEGRAM_STRANGER_MAX_PER_DAY=20

# ===== Дополнительно =====
# Клавиша сна/пробуждения и автосон после N секунд тишины.
WAKE_HOTKEY=f10
SLEEP_AFTER_SILENCE_S=180
# Разбудить голосом «Hey Jarvis» (локальная модель, без интернета). Порог 0.3 — чутче, 0.7 — строже.
WAKE_WORD_ENABLED=1
WAKE_WORD_THRESHOLD=0.5
# Город для погоды в утренней сводке (пусто — из памяти Джарвиса).
HOME_CITY=
# Источники новостей: «Название=ссылка на RSS» через запятую (пусто — УНИАН, РБК-Украина, BBC, Хабр).
NEWS_FEEDS=

# ===== Умный дом (Home Assistant) =====
# Адрес и «долгосрочный токен доступа» из профиля Home Assistant.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# ===== Заявки с сайта =====
# Джарвис раз в минуту проверяет новые заявки с сайта и присылает их в Telegram.
# Ключ — секрет NOTIFY_KEY сайта (только чтение заявок). Пусто — выключено.
SITE_LEADS_URL=https://jarvis-ai-site-98w.pages.dev
SITE_LEADS_KEY=
# MAC-адрес Bluetooth-ленты (приложение Lotus Lantern). Пусто — Джарвис найдёт её сам.
LED_STRIP_ADDRESS=

# ===== Почта =====
# Адрес и ПАРОЛЬ ПРИЛОЖЕНИЯ (не основной). Серверы Gmail/Яндекса/Mail.ru/Outlook/ukr.net подставятся сами.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
# Микрофон и динамики: номер или часть названия. Пусто = устройства Windows по умолчанию.
# Список: python worker.py console --list-devices
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
# 1 = память и анализ привычек идут через локальный `claude` CLI (подписка) вместо API-ключа.
# Включайте, только убедившись, что условия вашей подписки Anthropic это допускают.
USE_CLAUDE_CLI=0

# Папка с вашими проектами -- coding_agent ищет проекты по имени здесь (по умолчанию ~/Projects).
PROJECTS_DIR=
